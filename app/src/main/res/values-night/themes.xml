<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Orator" parent="android:Theme.Material.NoActionBar">
        <item name="windowSplashScreenBackground">@color/orator_splash_background_dark</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Orator.App.Dark</item>
    </style>

    <style name="Theme.Orator.App.Dark" parent="android:Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>
